KAMIKAZE (Wander){

// single line comment are allowed

* (Wander):
    | Closest(@)  ? Move(F)   : (Track)  // Si le joueur (P) est détecté n'importe où, on fonce vers lui
    | True        ? Move(F)   : (Wander)

  * (Track):
    | Closest(F, @)    ? Move(F)   : (Track)   // Si le joueur est droit devant, on avance
    | Closest(R, @)    ? Turn(R)   : (Track)   // S'il est à droite, on tourne à droite
    | Closest(L, @)    ? Turn(L)   : (Track)   // S'il est à gauche, on tourne à gauche
    | Closest(B, @)    ? Turn(B)   : (Track)   // S'il est derrière, on fait demi-tour
 
}

WALKING (Walking){

// single line comment are allowed

* (Walking):
    | Closest(@,5)  ? Hit($)   : (Shooting)  // Si le joueur (P) est détecté n'importe où, on fonce vers lui
    | Step(F,O)     ? Move(F)  : (Walking) 
    | True          ? Turn(B)  : (Walking)

  * (Shooting):
    | Closest(@,5)  ? Hit($)   : (Shooting)  // Si le joueur (P) est détecté n'importe où, on fonce vers lui
    | Step(F,O)     ? Move(F)  : (Walking) 
    | True          ? Turn(B)  : (Walking)
 
}